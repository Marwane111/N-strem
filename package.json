  "description": "Movie and TV discovery application with TMDB metadata, VidSrc availability integration, authorized external playback, secure accounts and personal watchlists.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
