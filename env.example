# ==================================================
# TITAN — Environment configuration template
#
# Copy this file to .env for your local configuration.
# Keep actual credentials in .env, not in this file.
# Never commit or publicly share .env.
# ==================================================


# ==================================================
# Application
# ==================================================

NODE_ENV=
HOST=
PORT=
APP_ORIGIN=

# Number of trusted reverse-proxy hops.
# Configure only for your actual hosting environment.
TRUST_PROXY_HOPS=


# ==================================================
# Database
#
# Path to the local SQLite database.
# The SQL schema remains a separate tracked source file.
# ==================================================

DATABASE_PATH=


# ==================================================
# Sessions
#
# Use an independently generated, unpredictable secret.
# Do not reuse a TMDB credential as a session secret.
# ==================================================

SESSION_SECRET=
SESSION_COOKIE_NAME=
SESSION_TTL_SECONDS=

# Whether the browser should send the session cookie
# only over HTTPS.
SESSION_COOKIE_SECURE=


# ==================================================
# TMDB
#
# Requests are made by the TITAN backend.
#
# Prefer the API Read Access Token.
# The API key is an alternative authentication method.
# Configure one method; do not expose either in the UI.
#
# Use newly rotated credentials, not credentials
# previously pasted into the conversation.
# ==================================================

TMDB_API_BASE_URL=
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=
TMDB_REGION=


# ==================================================
# VidSrc
#
# Catalogue and metadata configuration.
# No API key variable is required by the supplied docs.
#
# API and player origins are configured separately.
# Do not configure unverified mirror or custom domains.
# ==================================================

VIDSRC_API_ORIGIN=
VIDSRC_PLAYER_ORIGIN=

# External playback is enabled only when configured
# for content you are authorized to access.
VIDSRC_PLAYBACK_ENABLED=


# ==================================================
# Provider requests
#
# Timeout and cache duration values are milliseconds.
# ==================================================

PROVIDER_REQUEST_TIMEOUT_MS=
TMDB_CACHE_TTL_MS=
VIDSRC_CACHE_TTL_MS=


# ==================================================
# Request limits
#
# Window values are milliseconds.
# Maximum values are request counts per window.
# ==================================================

API_RATE_LIMIT_WINDOW_MS=
API_RATE_LIMIT_MAX=

AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=
